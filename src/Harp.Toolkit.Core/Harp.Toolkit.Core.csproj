<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>This package provides common toolkit infrastructure for inspecting, updating and interfacing with Harp devices.</Description>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Harp.Toolkit</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Bonsai.Harp" Version="3.6.1" />
    <PackageReference Include="System.IO.Ports" Version="6.0.0" />
  </ItemGroup>

</Project>